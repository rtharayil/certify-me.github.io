.sk-scope{font-family:Inter,"Segoe UI",Arial,sans-serif;color:#071d3b;font-size:13px}
.sk-scope button{font:inherit}
.sk-scope .content{padding:22px 24px 28px;max-width:1536px;margin:0 auto}
.sk-scope .back{display:flex;align-items:center;gap:8px;font-size:12px;font-weight:650;color:#071c3c;margin:0 0 19px 3px}
.sk-scope .back-arrow{font-size:20px;line-height:10px;font-weight:400}
.sk-scope .hero{display:grid;grid-template-columns:minmax(0,1fr) 250px 368px;gap:35px;align-items:center;padding:0 3px 17px}
.sk-scope .hero-main{display:flex;gap:16px;align-items:flex-start}
.sk-scope .competency-icon{width:61px;height:61px;display:grid;place-items:center;flex:none;overflow:hidden;border-radius:15px}
.sk-scope .competency-icon img{width:61px;height:61px;display:block;object-fit:cover}
.sk-scope .competency-icon svg{width:38px;height:38px;stroke:#fff}
.sk-scope h1{font-size:26px;line-height:1.1;margin:1px 0 10px;font-weight:780;letter-spacing:-.65px}
.sk-scope .desc{font-size:13px;line-height:1.65;color:#112d50;max-width:575px}
.sk-scope .verification{align-self:center}
.sk-scope .verified-pill{display:inline-flex;align-items:center;gap:8px;background:#d9f3e9;color:#073d35;font-weight:750;font-size:11px;padding:4px 9px;border-radius:3px;letter-spacing:.1px}
.sk-scope .shield{width:19px;height:19px;background:#07945f;display:inline-grid;place-items:center;border-radius:5px;clip-path:polygon(50% 0,90% 16%,86% 72%,50% 100%,14% 72%,10% 16%)}
.sk-scope .shield:after{content:"✓";font-size:11px;color:white;font-weight:800}
.sk-scope .verify-copy{margin-top:10px;font-size:12px;line-height:1.75;color:#132c4c}
.sk-scope .hero-buttons{display:flex;gap:9px;justify-content:flex-end}
.sk-scope .btn{height:39px;padding:0 27px;border-radius:6px;border:1px solid #0c7468;background:white;color:#00594e;font-weight:700;font-size:11.5px;display:flex;align-items:center;justify-content:center;gap:10px;white-space:nowrap}
.sk-scope .btn.primary{background:#006853;color:#fff;border-color:#006853;padding:0 23px}
.sk-scope .external{font-size:15px;line-height:0}
.sk-scope .download{font-size:16px;line-height:0}
.sk-scope .tabs{height:36px;border-bottom:1px solid #d9e1e6;display:flex;align-items:flex-start;padding-left:16px;gap:35px}
.sk-scope .tab{height:36px;padding:0 2px;font-size:11.5px;color:#142c4a;display:flex;align-items:center;position:relative}
.sk-scope .tab.active{font-weight:750}
.sk-scope .tab.active:after{content:"";position:absolute;bottom:-1px;left:-4px;right:-4px;height:3px;background:#006f5e;border-radius:3px 3px 0 0}
.sk-scope .grid{display:grid;grid-template-columns:1.13fr 1.06fr .98fr;gap:12px;margin-top:13px}
.sk-scope .card{border:1px solid #e0e6e9;border-radius:8px;background:#fff;box-shadow:0 1px 5px rgba(20,40,50,.07);overflow:hidden}
.sk-scope .card.pad{padding:16px 19px}
.sk-scope .card-title{font-size:13px;font-weight:780;color:#101820;margin-bottom:10px}
.sk-scope .info{display:inline-grid;place-items:center;width:12px;height:12px;border:1px solid #17314e;border-radius:50%;font-size:8px;margin-left:5px;vertical-align:1px;font-weight:700;color:#17314e}
.sk-scope .sub{font-size:10.5px;color:#1e3859;line-height:1.5}
.sk-scope .proficiency{height:270px}
.sk-scope .prof-body{display:flex;align-items:center;margin-top:7px;gap:19px}
.sk-scope .ring-wrap{width:169px;height:169px;position:relative;flex:none;display:grid;place-items:center}
.sk-scope .ring-wrap svg{position:absolute;inset:0;width:100%;height:100%;transform:rotate(-90deg)}
.sk-scope .ring-text{text-align:center;position:relative;margin-top:3px}
.sk-scope .ring-level{font-size:12px;font-weight:750;margin-bottom:2px}
.sk-scope .ring-number{font-size:45px;font-weight:790;line-height:.95;letter-spacing:-1px}
.sk-scope .ring-applied{font-size:11px;margin-top:6px}
.sk-scope .prof-copy{font-size:10.5px;color:#183454;line-height:1.55;max-width:205px}
.sk-scope .levels{margin-top:18px}
.sk-scope .level{display:grid;grid-template-columns:18px 51px 1fr;align-items:center;height:25px;font-size:10px;color:#183454}
.sk-scope .level-dot{width:10px;height:10px;border-radius:50%;background:#b8c2cc;position:relative;justify-self:center}
.sk-scope .level-dot.blue{background:#0876db}
.sk-scope .level-dot:before{content:"";position:absolute;width:1px;height:25px;background:#d0d8df;left:4px;top:-17px;z-index:-1}
.sk-scope .level:first-child .level-dot:before{display:none}
.sk-scope .level strong{font-weight:750}
.sk-scope .level .blue+span{font-weight:700}
.sk-scope .link{color:#004e96;font-weight:700;font-size:11.5px;display:flex;align-items:center;gap:10px}
.sk-scope .link.green{color:#006b58}
.sk-scope .arrow{font-size:19px;font-weight:400;line-height:10px}
.sk-scope .prof-link{margin-top:13px}
.sk-scope .mapped{height:270px}
.sk-scope .mapped .sub{margin-bottom:10px}
.sk-scope .skill-row{height:31px;display:flex;align-items:center;gap:9px}
.sk-scope .skill-icon{width:23px;height:23px;border-radius:50%;display:grid;place-items:center;color:white;flex:none}
.sk-scope .skill-icon svg{width:13px;height:13px;stroke:white}
.sk-scope .blue-bg{background:#1683d9}
.sk-scope .teal-bg{background:#00a68a}
.sk-scope .orange-bg{background:#f2761b}
.sk-scope .cyan-bg{background:#18a5aa}
.sk-scope .purple-bg{background:#9563d7}
.sk-scope .skill-name{font-size:10.5px;font-weight:650;flex:1;color:#0e2847}
.sk-scope .level-pill{font-size:10px;font-weight:700;padding:4px 8px;border-radius:5px}
.sk-scope .lp-blue{background:#dcecff;color:#0b66c4}
.sk-scope .lp-green{background:#d9f4e9;color:#07815e}
.sk-scope .lp-orange{background:#ffe6d4;color:#e66a00}
.sk-scope .lp-cyan{background:#dff4f4;color:#0a8b90}
.sk-scope .lp-purple{background:#eee3fa;color:#8051c1}
.sk-scope .mapped-link{margin-top:8px}
.sk-scope .badge-card{height:270px}
.sk-scope .badge-body{display:flex;align-items:center;gap:17px;margin-top:16px}
.sk-scope .badge-img{width:119px;height:137px;object-fit:cover;object-position:center;border-radius:3px}
.sk-scope .badge-details{font-size:11px;color:#19304d;line-height:1.65}
.sk-scope .badge-name{font-size:13px;font-weight:780;color:#071a35;line-height:1.45}
.sk-scope .badge-level{font-size:13px;font-weight:780;color:#071a35;margin-bottom:11px}
.sk-scope .mini-verified{display:inline-block;background:#d8f3e9;color:#087b5d;font-size:9.5px;font-weight:700;border-radius:4px;padding:3px 8px;margin-bottom:10px}
.sk-scope .badge-link{margin-top:14px}
.sk-scope .evidence{grid-column:1 / span 2;height:370px;padding:14px 19px}
.sk-scope .evidence-head{margin-bottom:8px}
.sk-scope .evidence-title{font-size:13px;font-weight:780;color:#101820}
.sk-scope .timeline{height:70px;display:grid;grid-template-columns:repeat(4,1fr);position:relative;margin-top:2px}
.sk-scope .timeline:before{content:"";position:absolute;left:39px;right:39px;top:27px;height:1px;background:#99c9c0}
.sk-scope .stage{display:flex;align-items:center;gap:9px;position:relative;z-index:1}
.sk-scope .stage-circle{width:29px;height:29px;border-radius:50%;background:#009263;color:white;display:grid;place-items:center;font-size:16px;font-weight:700;flex:none;box-shadow:0 0 0 2px #d9f2eb}
.sk-scope .stage-circle.current{background:#fff;color:#0b69ce;border:2px solid #0b72dc;box-shadow:0 0 0 2px #d8eafb}
.sk-scope .stage-text{line-height:1.45;font-size:10px}
.sk-scope .stage-title{font-weight:700;color:#112a49}
.sk-scope .stage-date{color:#102b4d}
.sk-scope .evidence-list-head{display:flex;align-items:center;justify-content:space-between;margin:0 0 6px}
.sk-scope .list-title{font-size:11.5px;font-weight:780;color:#101820}
.sk-scope .all-verified{background:#dcf5e9;color:#07845f;font-size:9px;font-weight:700;padding:4px 7px;border-radius:4px}
.sk-scope .files{border:1px solid #e2e7ea;border-radius:6px;overflow:hidden}
.sk-scope .file-row{height:42px;border-bottom:1px solid #e4e8eb;display:grid;grid-template-columns:35px 1fr 110px 35px 35px;align-items:center;padding:0 10px;column-gap:7px}
.sk-scope .file-row:last-child{border-bottom:0}
.sk-scope .file-icon{width:25px;height:27px;border-radius:5px;display:grid;place-items:center;color:#fff;font-weight:800;font-size:11px}
.sk-scope .pdf{background:#ee3939}
.sk-scope .ppt{background:#ff8a19}
.sk-scope .video{background:#1685dd}
.sk-scope .doc{background:#8750cf}
.sk-scope .file-main{line-height:1.35}
.sk-scope .file-name{font-size:10.5px;font-weight:700;color:#122a47}
.sk-scope .file-meta{font-size:9.5px;color:#4a5e77}
.sk-scope .dotsep{margin:0 7px}
.sk-scope .file-status{font-size:10px;font-weight:700;color:#007b59;display:flex;align-items:center;gap:5px}
.sk-scope .check-small{width:12px;height:12px;border:1.5px solid #00a170;border-radius:50%;display:grid;place-items:center;font-size:8px}
.sk-scope .action-icon{width:22px;height:22px;display:grid;place-items:center;color:#06264a;cursor:pointer}
.sk-scope .action-icon svg{width:19px;height:19px;display:block}
.sk-scope .download-btn svg{width:20px;height:20px}
.sk-scope .view-all{justify-content:center;margin-top:12px}
.sk-scope .verified-by{height:225px;padding:17px 19px}
.sk-scope .org{display:flex;align-items:center;gap:12px;margin-top:17px}
.sk-scope .org-logo{width:40px;height:40px;border-radius:50%;background:#e7f5ef;display:grid;place-items:center;color:#008d63}
.sk-scope .org-name{font-size:11px;font-weight:750;color:#102846}
.sk-scope .org-country{font-size:10px;color:#39516b;margin-top:4px}
.sk-scope .lead{font-size:10px;color:#304863;margin-top:15px;margin-bottom:7px}
.sk-scope .faces{display:flex;gap:7px}
.sk-scope .face{width:27px;height:27px;border-radius:50%;object-fit:cover;display:block}
.sk-scope .outline-btn{margin-top:14px;height:33px;border:1px solid #07836f;color:#006c5d;background:white;border-radius:5px;padding:0 12px;font-size:10.5px;font-weight:700;display:flex;align-items:center;gap:8px}
.sk-scope .impact{height:202px;padding:16px 19px;background:linear-gradient(110deg,#f7fbf9,#eef7f4);border-color:#e2ece8}
.sk-scope .impact-row{display:flex;gap:12px;align-items:flex-start;margin-top:18px}
.sk-scope .impact-icon{width:39px;height:39px;border-radius:50%;background:#fff;display:grid;place-items:center;color:#008c68;flex:none}
.sk-scope .impact-copy{font-size:10.5px;line-height:1.65;color:#1b3552;padding-top:1px}
.sk-scope .impact-link{margin-top:17px}
.sk-scope .growth{grid-column:1 / span 2;height:69px;background:#fffaf0;border:1px solid #f4ead0;border-radius:7px;display:flex;align-items:center;padding:0 13px;justify-content:space-between}
.sk-scope .growth-left{display:flex;align-items:center;gap:13px}
.sk-scope .star-circle{width:43px;height:43px;border-radius:50%;background:#fff0cb;display:grid;place-items:center;color:#f49b00;font-size:23px}
.sk-scope .growth-title{font-size:12px;font-weight:780;color:#111;margin-bottom:3px}
.sk-scope .growth-copy{font-size:9.5px;line-height:1.45;color:#2d4560;max-width:570px}
.sk-scope .growth-btn{height:35px;background:#006b59;color:white;border:0;border-radius:5px;padding:0 21px;font-size:10.5px;font-weight:700;display:flex;align-items:center;gap:9px}
@media(max-width:1100px){
.sk-scope .hero{grid-template-columns:1fr 230px;}
.sk-scope .hero-buttons{grid-column:1/-1;justify-content:flex-start}
.sk-scope .grid{grid-template-columns:1fr 1fr}
.sk-scope .badge-card,
.sk-scope .verified-by,
.sk-scope .impact{grid-column:auto}
.sk-scope .evidence,
.sk-scope .growth{grid-column:1/-1}
}
@media(max-width:760px){
.sk-scope .content{padding:18px 14px}
.sk-scope .hero{grid-template-columns:1fr}
.sk-scope .hero-buttons{justify-content:flex-start;flex-wrap:wrap}
.sk-scope .grid{grid-template-columns:1fr}
.sk-scope .evidence,
.sk-scope .growth{grid-column:auto}
.sk-scope .timeline{grid-template-columns:1fr 1fr;height:auto;row-gap:13px}
.sk-scope .timeline:before{display:none}
.sk-scope .evidence{height:auto}
.sk-scope .file-row{grid-template-columns:30px 1fr 80px 28px 28px}
.sk-scope .growth{height:auto;padding:12px;gap:10px;align-items:flex-start}
.sk-scope .growth-btn{margin-top:4px}
}