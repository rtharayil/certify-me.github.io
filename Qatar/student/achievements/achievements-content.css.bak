.ach-scope{font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;color:#122922;font-size:14px;-webkit-font-smoothing:antialiased}
.ach-scope{
  --ink:#082622; --navy:#0b3a30; --muted:#5c6b66; --muted2:#7c8b86;
  --line:#e6eaea; --green:#0a7a52; --green2:#0d8a5c; --green-dark:#04352d;
  --mint:#d9f7ea; --mint-text:#0f7350; --mint-bg:#f3faf7;
  --blue:#2f7fe0; --blue-bg:#e6f0fd;
  --purple:#7a52d6; --purple-bg:#efe7fb;
  --orange:#ee9d0d; --orange-bg:#fdeecb;
}
.ach-scope a{color:inherit;text-decoration:none}
.ach-scope img{display:block}
.ach-scope svg{display:block}
.ach-scope /* ---------- CONTENT ---------- */
.content{flex:1;min-width:0;display:flex;flex-direction:column}
.ach-scope .main{padding:26px 32px 44px}
.ach-scope .back{display:flex;align-items:center;gap:6px;font-size:13px;font-weight:700;color:var(--navy);margin-bottom:14px}
.ach-scope .back svg{width:14px;height:14px;stroke:currentColor;fill:none;stroke-width:2}
.ach-scope h1{font-size:28px;line-height:1.15;margin:0 0 6px;font-weight:800;color:var(--ink);letter-spacing:-.3px}
.ach-scope .sub{font-size:14px;color:var(--muted);margin-bottom:20px}
.ach-scope .layout{display:grid;grid-template-columns:minmax(0,1fr) 372px;gap:22px;align-items:start}
.ach-scope .left,
.ach-scope .right{min-width:0;display:flex;flex-direction:column;gap:20px}
.ach-scope .card{background:#fff;border:1px solid var(--line);border-radius:14px}
.ach-scope /* ---------- HERO ---------- */
.hero{background:var(--mint-bg);padding:26px 30px;display:flex;align-items:center;justify-content:space-between;gap:20px;position:relative;overflow:hidden}
.ach-scope .confetti i{position:absolute;width:5px;height:5px;border-radius:1px;transform:rotate(40deg)}
.ach-scope .hero-left{display:flex;align-items:center;gap:20px;min-width:0}
.ach-scope .badge-wrap{position:relative;width:76px;height:88px;flex:none;display:flex;align-items:center;justify-content:center}
.ach-scope .shield{width:60px;height:70px;background:var(--green);clip-path:polygon(50% 0,92% 18%,92% 64%,50% 100%,8% 64%,8% 18%);display:flex;align-items:center;justify-content:center}
.ach-scope .shield svg{width:32px;height:32px;stroke:#fff;fill:none;stroke-width:3}
.ach-scope .hero-copy{min-width:0}
.ach-scope .congrats{font-size:14px;font-weight:700;color:#111;margin-bottom:8px}
.ach-scope .hero-big{font-size:20px;font-weight:800;letter-spacing:-.2px;color:#080d14;margin-bottom:8px}
.ach-scope .hero-small{font-size:13px;color:var(--muted)}
.ach-scope .hero-right{display:flex;align-items:center;gap:16px;flex:none}
.ach-scope .medal-wrap{position:relative;width:66px;height:86px;flex:none}
.ach-scope .medal{width:64px;height:62px;background:var(--green-dark);clip-path:polygon(50% 0,91% 19%,91% 72%,50% 100%,9% 72%,9% 19%);display:flex;align-items:center;justify-content:center;position:relative;z-index:2}
.ach-scope .medal svg{width:28px;height:28px;stroke:#fff;fill:none;stroke-width:1.7}
.ach-scope .medal-tails{position:absolute;left:14px;top:52px;width:36px;height:30px;z-index:1}
.ach-scope .medal-tails i{position:absolute;bottom:0;width:14px;height:26px;background:var(--green-dark)}
.ach-scope .medal-tails i:first-child{left:0;clip-path:polygon(0 0,100% 0,100% 100%,50% 78%,0 100%)}
.ach-scope .medal-tails i:last-child{right:0;clip-path:polygon(0 0,100% 0,100% 100%,50% 78%,0 100%)}
.ach-scope .medal-copy{min-width:0;white-space:nowrap}
.ach-scope .medal-skill{font-size:14px;font-weight:800;color:#111;margin-bottom:6px;display:flex;align-items:center;gap:7px}
.ach-scope .level{display:inline-block;background:var(--mint);color:var(--mint-text);border-radius:6px;padding:3px 8px;font-size:10.5px;font-weight:800}
.ach-scope .medal-date{font-size:11px;color:var(--muted)}
.ach-scope /* ---------- SUMMARY ---------- */
.summary{padding:20px 22px}
.ach-scope .section-title{font-size:15px;font-weight:800;color:#111}
.ach-scope .summary-top{display:flex;align-items:center;justify-content:space-between;margin-bottom:16px}
.ach-scope .review-btn{height:30px;border:1px solid #cfe0dc;border-radius:7px;background:#fff;padding:0 12px;font-size:11.5px;color:var(--navy);font-weight:700;display:flex;align-items:center;gap:6px;cursor:pointer}
.ach-scope .review-btn svg{width:12px;height:12px;stroke:currentColor;fill:none;stroke-width:2.2}
.ach-scope .summary-row{display:grid;grid-template-columns:1.15fr 1.2fr 1fr 1fr .85fr}
.ach-scope .metric{min-width:0;padding:0 16px;border-right:1px solid var(--line)}
.ach-scope .metric:first-child{padding-left:0}
.ach-scope .metric:last-child{border-right:0}
.ach-scope .metric-label{display:flex;align-items:center;gap:6px;font-size:11.5px;color:var(--muted);margin-bottom:9px;white-space:nowrap}
.ach-scope .metric-label svg{width:15px;height:15px;stroke:#0a2447;fill:none;stroke-width:1.5}
.ach-scope .metric-value{font-size:13px;color:#111;font-weight:800;white-space:nowrap}
.ach-scope .metric .level{margin-top:6px}
.ach-scope .verified-pill{display:inline-flex;align-items:center;gap:4px;background:var(--mint);color:var(--mint-text);border-radius:14px;padding:4px 9px;font-size:11.5px;font-weight:800}
.ach-scope .verified-pill svg{width:11px;height:11px;stroke:currentColor;fill:none;stroke-width:2.6}
.ach-scope .score{font-size:14px;font-weight:800;color:#111}
.ach-scope .excellent{font-size:11.5px;color:var(--muted);margin-top:4px}
.ach-scope /* ---------- MEANS ---------- */
.means{padding:20px 22px}
.ach-scope .means-row{display:grid;grid-template-columns:repeat(4,1fr);margin-top:16px}
.ach-scope .mean{display:flex;gap:11px;padding:0 14px;border-right:1px solid var(--line)}
.ach-scope .mean:first-child{padding-left:0}
.ach-scope .mean:last-child{border-right:0;padding-right:0}
.ach-scope .circle{width:38px;height:38px;border-radius:50%;display:flex;align-items:center;justify-content:center;flex:none}
.ach-scope .circle svg{width:19px;height:19px;stroke:currentColor;fill:none;stroke-width:1.6}
.ach-scope .green{background:var(--mint);color:var(--green)}
.ach-scope .blue{background:var(--blue-bg);color:var(--blue)}
.ach-scope .purple{background:var(--purple-bg);color:var(--purple)}
.ach-scope .orange{background:var(--orange-bg);color:var(--orange)}
.ach-scope .mean h3{font-size:12.5px;color:#111;font-weight:800;margin:2px 0 6px}
.ach-scope .mean p{font-size:11.5px;line-height:1.5;color:var(--muted);margin:0}
.ach-scope /* ---------- SKILLS ---------- */
.skills{padding:20px 22px;position:relative}
.ach-scope .skill-row{display:grid;grid-template-columns:repeat(5,1fr);gap:12px;margin-top:16px}
.ach-scope .skill{border:1px solid var(--line);border-radius:10px;padding:12px 10px 12px;position:relative;background:#fff;display:flex;flex-direction:column;height:98px}
.ach-scope .skill.selected{border:1.5px solid var(--green)}
.ach-scope .skill-check{position:absolute;right:-7px;top:-7px;width:18px;height:18px;background:var(--green);border-radius:50%;display:flex;align-items:center;justify-content:center;color:#fff;font-size:10px;border:2px solid #fff}
.ach-scope .skill-check svg{width:9px;height:9px;stroke:#fff;stroke-width:3;fill:none}
.ach-scope .skill-top{display:flex;align-items:flex-start;gap:7px;flex:1}
.ach-scope .skill-icon{width:30px;height:30px;border-radius:50%;display:flex;align-items:center;justify-content:center;flex:none}
.ach-scope .skill-icon svg{width:16px;height:16px;stroke:currentColor;fill:none;stroke-width:1.6}
.ach-scope .skill-name{font-size:11.3px;font-weight:800;color:#111;line-height:1.25}
.ach-scope .skill-lvl{font-size:10.5px;color:var(--muted);margin-top:3px}
.ach-scope .bar{height:5px;background:#e9edec;border-radius:3px;overflow:hidden;margin-top:auto}
.ach-scope .bar b{display:block;height:100%;background:var(--green);border-radius:3px}
.ach-scope .bar.orange b{background:var(--orange)}
.ach-scope .all{font-size:12.5px;color:#0a5b98;font-weight:700;text-align:center;margin-top:16px;display:flex;align-items:center;justify-content:center;gap:6px}
.ach-scope .all svg{width:12px;height:12px;stroke:currentColor;fill:none;stroke-width:2.4}
.ach-scope .skill-nav{position:absolute;right:-14px;top:50%;transform:translateY(-4px);width:26px;height:26px;border-radius:50%;background:#fff;border:1px solid var(--line);display:flex;align-items:center;justify-content:center;box-shadow:0 2px 5px rgba(0,0,0,.08)}
.ach-scope .skill-nav svg{width:12px;height:12px;stroke:#173226;fill:none;stroke-width:2.2}
.ach-scope /* ---------- CTA ---------- */
.cta{padding:18px 22px;background:var(--mint-bg);display:flex;align-items:center;justify-content:space-between;gap:14px}
.ach-scope .cta-left{display:flex;align-items:center;gap:14px;min-width:0}
.ach-scope .target{width:44px;height:44px;border-radius:50%;background:var(--mint);color:var(--green);display:flex;align-items:center;justify-content:center;flex:none}
.ach-scope .target svg{width:24px;height:24px;fill:none;stroke:currentColor;stroke-width:1.5}
.ach-scope .cta-title{font-size:14.5px;font-weight:800;color:#111;margin-bottom:5px}
.ach-scope .cta-sub{font-size:12px;color:var(--muted)}
.ach-scope .cta-btn{height:42px;border:0;border-radius:8px;background:var(--green-dark);color:#fff;font-size:12.5px;font-weight:700;flex:none;padding:0 20px;display:flex;align-items:center;gap:8px;cursor:pointer}
.ach-scope .cta-btn svg{width:13px;height:13px;stroke:#fff;fill:none;stroke-width:2.4}
.ach-scope /* ---------- RIGHT COLUMN ---------- */
.right-title{font-size:15px;font-weight:800;color:#111;margin-bottom:14px}
.ach-scope .credential-wrap{padding:18px}
.ach-scope .credential{border:1px solid var(--line);border-radius:10px;overflow:hidden;position:relative}
.ach-scope .cred-band{height:38px;background:linear-gradient(90deg,var(--green-dark),#0a5748);display:flex;align-items:center;justify-content:space-between;padding:0 12px;color:#fff}
.ach-scope .cred-band-logo{display:flex;align-items:center;gap:7px}
.ach-scope .cred-band-logo img{width:19px;height:auto}
.ach-scope .cred-band-logo b{font-size:8.5px;font-weight:800;line-height:1.15;display:block;letter-spacing:.2px}
.ach-scope .cred-band span.right{font-size:9.5px;font-weight:700}
.ach-scope .cred-body{padding:16px 14px 44px;display:flex;gap:12px}
.ach-scope .cred-medal{width:52px;height:56px;flex:none;position:relative}
.ach-scope .cred-medal .medal{width:52px;height:50px}
.ach-scope .cred-medal .medal svg{width:22px;height:22px}
.ach-scope .cred-medal .medal-tails{left:11px;top:42px;width:30px;height:24px}
.ach-scope .cred-medal .medal-tails i{width:12px;height:22px}
.ach-scope .cred-name{font-size:15px;font-weight:800;color:#111;margin-bottom:7px}
.ach-scope .cred-text .level{font-size:10.5px;padding:3px 8px}
.ach-scope .cred-date,
.ach-scope .cred-by{font-size:11px;color:var(--muted);margin-top:6px}
.ach-scope .cred-id{position:absolute;left:14px;bottom:12px;font-size:9px;color:#8a97a3}
.ach-scope .qr{position:absolute;right:12px;bottom:10px;width:46px;height:46px;object-fit:cover;border-radius:2px}
.ach-scope .view{height:38px;border:1px solid var(--line);border-radius:8px;margin-top:12px;display:flex;align-items:center;justify-content:center;gap:7px;font-size:12.5px;font-weight:700;color:var(--green-dark);cursor:pointer}
.ach-scope .view svg{width:12px;height:12px;stroke:currentColor;fill:none;stroke-width:2.4}
.ach-scope .next{padding:18px}
.ach-scope .next-item{display:flex;align-items:center;gap:12px;padding:11px 0}
.ach-scope .next-item+.next-item{border-top:1px solid var(--line)}
.ach-scope .next-icon{width:38px;height:38px;border-radius:50%;display:flex;align-items:center;justify-content:center;flex:none}
.ach-scope .next-icon svg{width:18px;height:18px;stroke:currentColor;fill:none;stroke-width:1.6}
.ach-scope .next-copy{flex:1;min-width:0}
.ach-scope .next-copy b{display:block;font-size:12.5px;color:#111;margin-bottom:3px}
.ach-scope .next-copy span{font-size:11px;color:var(--muted)}
.ach-scope .arrow{width:14px;height:14px;stroke:#10284a;fill:none;stroke-width:1.8;flex:none}
.ach-scope .n-green{background:var(--mint);color:var(--green)}
.ach-scope .n-blue{background:var(--blue-bg);color:var(--blue)}
.ach-scope .n-purple{background:var(--purple-bg);color:var(--purple)}
.ach-scope .timeline{padding:18px}
.ach-scope .timeline-wrap{position:relative;padding-left:20px;margin-top:2px}
.ach-scope .timeline-wrap:before{content:"";position:absolute;left:5px;top:6px;bottom:34px;width:1px;background:#c7e3d8}
.ach-scope .event{position:relative;padding-bottom:18px}
.ach-scope .dot{position:absolute;left:-20px;top:2px;width:11px;height:11px;border-radius:50%;background:var(--green2);display:flex;align-items:center;justify-content:center}
.ach-scope .dot svg{width:6px;height:6px;stroke:#fff;stroke-width:3;fill:none}
.ach-scope .dot.blue{background:var(--blue)}
.ach-scope .event-main{display:flex;justify-content:space-between;gap:8px}
.ach-scope .event-title{font-size:12.5px;font-weight:800;color:#111}
.ach-scope .event-time{font-size:10.5px;color:var(--muted);text-align:right;line-height:1.4;white-space:nowrap}
.ach-scope .event-sub{font-size:11px;color:var(--muted);margin-top:4px}
.ach-scope .timeline-link{font-size:12.5px;color:#0a5b98;font-weight:700;margin-top:2px;display:flex;align-items:center;gap:6px}
.ach-scope .timeline-link svg{width:12px;height:12px;stroke:currentColor;fill:none;stroke-width:2.4}