.qsg-scope{font-family:Inter,Arial,Helvetica,sans-serif;color:#102c48;font-size:17px}
.qsg-scope button{font:inherit;border:0;background:none;cursor:pointer}
.qsg-scope .page{max-width:1644px;margin:0 auto;padding:19px 29px 22px}
.qsg-scope .intro-row{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:14px}
.qsg-scope .back{display:flex;gap:10px;align-items:center;padding:0;margin:0 0 10px;color:#0b2946;font-size:14px;font-weight:500}
.qsg-scope .arrow-left{width:11px;height:11px;border-left:1.5px solid #0b2946;border-bottom:1.5px solid #0b2946;transform:rotate(45deg)}
.qsg-scope h1{margin:0;color:#102f4e;font-size:28px;line-height:1.1;letter-spacing:-.7px}
.qsg-scope p.subtitle{margin:7px 0 0;color:#40536b;font-size:14px}
.qsg-scope .analysis-note{width:276px;height:77px;border:1px solid #e0e7eb;border-radius:14px;display:flex;align-items:center;gap:13px;padding:13px;box-shadow:0 2px 8px #0b2b4509;font-size:13px;line-height:16px;color:#263a50}
.qsg-scope .round-icon{width:43px;height:43px;border-radius:50%;background:#e4f7ef;position:relative;flex:none}
.qsg-scope .trend:before{content:"↗";position:absolute;left:11px;top:4px;color:#07955d;font-size:23px;font-weight:600}
.qsg-scope .main-grid{display:grid;grid-template-columns:minmax(0,1fr) 395px;gap:24px}
.qsg-scope .left-column{min-width:0}
.qsg-scope .card{background:#fff;border:1px solid #e4e9ed;border-radius:14px;box-shadow:0 2px 12px #0b2b4508}
.qsg-scope .overview-card{overflow:hidden}
.qsg-scope .tabs{height:50px;border-bottom:1px solid #e7ecef;display:flex;align-items:end;padding-left:10px}
.qsg-scope .tab{height:50px;padding:0 22px;position:relative;font-size:14px;font-weight:600;color:#26374c}
.qsg-scope .tab.active{color:#087c54}
.qsg-scope .tab.active:after{content:"";height:4px;position:absolute;bottom:0;left:13px;right:13px;background:#13b39c;border-radius:5px 5px 0 0}
.qsg-scope .overview-grid{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(280px,.86fr);gap:17px;padding:14px}
.qsg-scope .inner-card{box-shadow:none;border-color:#e2e7eb}
.qsg-scope .inner-card h2,
.qsg-scope .right-column h2{font-size:18px;margin:0;color:#121d2d}
.qsg-scope .competencies-card{padding:19px 17px 0}
.qsg-scope .table-head{display:grid;grid-template-columns:minmax(0,1fr) 145px 95px 60px;border-top:1px solid #edf0f2;border-bottom:1px solid #edf0f2;margin-top:14px;padding:8px 0;font-size:13px;color:#26374d}
.qsg-scope .competency{display:grid;grid-template-columns:minmax(0,1fr) 145px 95px 60px;align-items:center;min-height:48px;border-bottom:1px solid #edf0f2}
.qsg-scope .competency-name{display:flex;align-items:center;gap:12px;min-width:0}
.qsg-scope .skill-icon{width:38px;height:38px;border-radius:11px;display:grid;place-items:center;flex:none;position:relative}
.qsg-scope .skill-icon.green{background:linear-gradient(135deg,#0da468,#008d56)}
.qsg-scope .skill-icon.cyan{background:linear-gradient(135deg,#21c5cb,#0098a0)}
.qsg-scope .skill-icon.blue{background:linear-gradient(135deg,#258ddd,#1767c8)}
.qsg-scope .skill-icon.purple{background:linear-gradient(135deg,#7d59ca,#6743af)}
.qsg-scope .skill-icon.orange{background:linear-gradient(135deg,#ff7d18,#ed5208)}
.qsg-scope .skill-icon.yellow{background:linear-gradient(135deg,#ffbd10,#f29a00)}
.qsg-scope .svg{width:26px;height:26px;display:block;position:relative}
.qsg-scope .svg:before,
.qsg-scope .svg:after{content:"";position:absolute;border-color:#fff}
.qsg-scope .network:before{inset:6px;border:1.5px solid #fff;border-radius:50%;box-shadow:-7px 7px 0 -5px #fff,7px 7px 0 -5px #fff}
.qsg-scope .network:after{width:18px;height:2px;background:#fff;left:5px;top:13px;transform:rotate(35deg);box-shadow:0 0 0 #fff}
.qsg-scope .leaf:before{width:16px;height:23px;border:1.5px solid #fff;border-radius:100% 0 100% 0;transform:rotate(40deg);left:5px;top:0}
.qsg-scope .leaf:after{width:2px;height:20px;background:#fff;left:12px;top:5px;transform:rotate(42deg)}
.qsg-scope .chart:before{left:4px;bottom:4px;width:19px;height:18px;border-left:1.5px solid #fff;border-bottom:1.5px solid #fff}
.qsg-scope .chart:after{left:7px;bottom:7px;width:5px;height:10px;background:#fff;box-shadow:6px -4px 0 #fff,12px -9px 0 #fff}
.qsg-scope .message:before{inset:4px 2px 5px;border:1.5px solid #fff;border-radius:7px}
.qsg-scope .message:after{width:8px;height:8px;border-left:1.5px solid #fff;border-bottom:1.5px solid #fff;left:6px;bottom:1px;transform:skew(-20deg)}
.qsg-scope .users:before{width:10px;height:10px;border:1.5px solid #fff;border-radius:50%;left:8px;top:2px}
.qsg-scope .users:after{width:18px;height:10px;border:1.5px solid #fff;border-radius:11px 11px 4px 4px;left:4px;bottom:2px}
.qsg-scope .bulb:before{width:13px;height:16px;border:1.5px solid #fff;border-radius:50%;left:6px;top:1px}
.qsg-scope .bulb:after{width:10px;height:5px;border-bottom:1.5px solid #fff;border-top:1.5px solid #fff;left:8px;bottom:2px}
.qsg-scope .name-copy{min-width:0}
.qsg-scope .name-copy b{display:block;font-size:13px;white-space:normal;overflow-wrap:break-word;line-height:1.25;color:#18253a}
.qsg-scope .name-copy small{display:block;font-size:12px;color:#68768a;margin-top:2px}
.qsg-scope .current-level{display:flex;align-items:center;gap:11px}
.qsg-scope .current-level b,
.qsg-scope .target-level{font-size:13px;font-weight:600;color:#087c54}
.qsg-scope .bar{height:8px;width:77px;border-radius:119px;background:#e4e9ed;overflow:hidden}
.qsg-scope .bar i{display:block;height:100%;background:#0b9e61;border-radius:119px}
.qsg-scope .target-level{color:#087c54}
.qsg-scope .gap-pill{width:max-content;border-radius:10px;padding:5px 8px;font-size:12px;font-weight:500}
.qsg-scope .gap-pill.ok{background:#e7f8f1;color:#19845b}
.qsg-scope .gap-pill.warn{background:#fff2d9;color:#dd9510}
.qsg-scope .gap-pill.bad{background:#ffe7e7;color:#e14e4e}
.qsg-scope .legend{display:flex;gap:17px;flex-wrap:wrap;padding:10px 0 7px;font-size:11px;color:#566579}
.qsg-scope .dot{width:11px;height:11px;border-radius:50%;display:inline-block;margin-right:8px}
.qsg-scope .dot.green{background:#15975f}
.qsg-scope .dot.amber{background:#eca000}
.qsg-scope .dot.red{background:#e84b4b}
.qsg-scope .radar-card{padding:17px 17px 10px}
.qsg-scope .radar-legend{display:flex;justify-content:center;gap:22px;margin-top:10px;font-size:12px;color:#293b50}
.qsg-scope .solid-line,
.qsg-scope .dashed-line{display:inline-block;width:32px;border-top:3px solid #15975f;margin:0 10px 2px 0}
.qsg-scope .dashed-line{border-top:2px dashed #1768ff}
.qsg-scope .radar{display:block;width:100%;max-width:276px;height:auto;margin:5px auto 0}
.qsg-scope .focus-box{border:1px solid #dce9e7;background:#f4fbf9;border-radius:11px;min-height:40px;display:flex;align-items:center;gap:11px;padding:8px 12px;font-size:12px;line-height:14px;color:#46586d;margin-top:12px}
.qsg-scope .focus-bulb{width:20px;height:20px;border:1.5px solid #15975f;border-radius:50%;position:relative;flex:none}
.qsg-scope .focus-bulb:after{content:"";position:absolute;width:8px;height:10px;border-bottom:1.5px solid #15975f;left:7px;bottom:-5px}
.qsg-scope .hidden-panel{display:none;padding:36px 30px;min-height:390px}
.qsg-scope .hidden-panel h2{font-size:22px}
.qsg-scope .hidden-panel p{font-size:16px;color:#647286}
.qsg-scope .way-card{margin-top:17px;min-height:80px;border:1px solid #d9ece7;border-radius:14px;background:linear-gradient(90deg,#edf9f6,#f8fbfa);display:flex;align-items:center;padding:0 24px;gap:19px}
.qsg-scope .mountain{width:96px;height:72px;position:relative;flex:none;display:flex;align-items:center;justify-content:center}
.qsg-scope .mountain img{width:100%;height:100%;object-fit:contain}
.qsg-scope .way-copy h3{margin:0;font-size:17px;color:#111d2d}
.qsg-scope .way-copy p{margin:5px 0 0;font-size:13px;line-height:16px;color:#526277}
.qsg-scope .way-card>button{margin-left:auto;background:#0c3047;color:#fff;padding:11px 19px;border-radius:10px;font-size:14px;font-weight:600;white-space:nowrap}
.qsg-scope .right-column{display:flex;flex-direction:column;gap:14px}
.qsg-scope .goal-card{background:linear-gradient(180deg,#eefaf7,#f8fcfb);border-color:#dcece8;padding:17px 17px 19px}
.qsg-scope .card-heading{display:flex;align-items:center;justify-content:space-between}
.qsg-scope .card-heading h2{font-size:17px}
.qsg-scope .card-heading button{font-size:13px;color:#087bcb;font-weight:500}
.qsg-scope .goal-main{display:flex;gap:14px;align-items:center;margin-top:14px}
.qsg-scope .target-circle{width:70px;height:70px;border-radius:50%;background:#dcf3eb;display:grid;place-items:center;flex:none}
.qsg-scope .target-icon{width:41px;height:41px;object-fit:contain}
.qsg-scope .goal-main h3{font-size:18px;margin:0 0 7px;color:#132b49}
.qsg-scope .goal-main small{display:block;color:#55657a;font-size:13px;margin-top:2px}
.qsg-scope .match-box{height:86px;border:1px solid #e0e7e8;background:#fff;border-radius:13px;margin-top:14px;display:flex;align-items:center;padding:0 17px}
.qsg-scope .match{width:120px;border-right:1px solid #e7ecee}
.qsg-scope .match small{display:block;font-size:12px;color:#33475c}
.qsg-scope .match strong{display:block;margin-top:5px;font-size:25px;color:#087c54}
.qsg-scope .develop{font-size:13px;font-weight:600;line-height:16px;padding-left:17px;color:#101b2b}
.qsg-scope .circle-up{margin-left:auto;width:36px;height:36px;border-radius:50%;background:#e7f7f2;display:grid;place-items:center;color:#12586a;font-size:22px}
.qsg-scope .goal-edit{display:none;margin-top:12px;background:#fff;border:1px solid #e2e8e9;padding:11px;border-radius:8px;font-size:13px;color:#536276}
.qsg-scope .goal-edit.show{display:block}
.qsg-scope .summary-card,
.qsg-scope .steps-card{padding:17px 17px}
.qsg-scope .summary-card h2,
.qsg-scope .steps-card h2{font-size:17px}
.qsg-scope .total{display:flex;justify-content:space-between;margin-top:14px;font-size:14px}
.qsg-scope .summary-line{border-top:1px solid #edf0f2;display:flex;justify-content:space-between;padding:11px 0;font-size:13px;color:#27384d}
.qsg-scope .summary-line:first-of-type{margin-top:7px}
.qsg-scope .steps-card button{width:100%;display:flex;align-items:center;gap:12px;text-align:left;padding:10px 0}
.qsg-scope .steps-card button+button{border-top:1px solid #edf0f2}
.qsg-scope .step-icon{width:34px;height:34px;border-radius:50%;background:#e9f2ff;position:relative;flex:none}
.qsg-scope .step-icon:before{content:"";position:absolute;inset:11px;border:1.5px solid #2276dc;border-radius:2px}
.qsg-scope .step-icon.book:after{content:"";position:absolute;width:10px;height:1px;background:#2276dc;left:16px;top:17px}
.qsg-scope .step-icon.bag:after{content:"";position:absolute;width:10px;height:6px;border:1.5px solid #2276dc;border-bottom:0;border-radius:5px 5px 0 0;left:16px;top:8px}
.qsg-scope .step-icon.verify:after{content:"✓";position:absolute;left:13px;top:8px;color:#2276dc;font-size:16px}
.qsg-scope .step-icon.clock:before{border-radius:50%}
.qsg-scope .steps-card button>span:nth-child(2){flex:1;min-width:0}
.qsg-scope .steps-card b{display:block;font-size:13px;color:#16263a;font-weight:500}
.qsg-scope .steps-card small{display:block;font-size:12px;color:#6a7788;margin-top:6px}
.qsg-scope .right-arrow{font-size:28px;color:#142c45}
@media(max-width:1400px){
.qsg-scope .main-grid{grid-template-columns:minmax(0,1fr) 340px}
.qsg-scope .overview-grid{grid-template-columns:1fr}
.qsg-scope .analysis-note{display:none}
.qsg-scope .table-head,
.qsg-scope .competency{grid-template-columns:minmax(120px,1fr) 125px 80px 55px}
.qsg-scope .current-level{gap:8px}
.qsg-scope .bar{width:74px}
}
@media(max-width:1100px){
.qsg-scope .main-grid{grid-template-columns:1fr}
.qsg-scope .right-column{flex-direction:row;flex-wrap:wrap}
.qsg-scope .right-column>.card{flex:1 1 260px}
.qsg-scope .table-head,
.qsg-scope .competency{grid-template-columns:minmax(150px,1fr) 145px 95px 60px}
.qsg-scope .current-level{gap:13px}
.qsg-scope .bar{width:94px}
}
@media(max-width:900px){
.qsg-scope .main-grid{grid-template-columns:1fr}
.qsg-scope .right-column{display:grid;grid-template-columns:1fr 1fr}
.qsg-scope .steps-card{grid-column:1/-1}
.qsg-scope .page{padding:30px 19px}
.qsg-scope .way-card{padding:14px 22px}
.qsg-scope .mountain{display:none}
}
@media(max-width:620px){
.qsg-scope .right-column{display:flex}
.qsg-scope .tabs{overflow-x:auto}
.qsg-scope .tab{padding:0 17px;white-space:nowrap}
.qsg-scope .overview-grid{padding:12px}
.qsg-scope .table-head{display:none}
.qsg-scope .competency{grid-template-columns:1fr;row-gap:7px;padding:14px 0;min-height:0}
.qsg-scope .competency-name{grid-column:1}
.qsg-scope .current-level,
.qsg-scope .target-level,
.qsg-scope .gap-pill{grid-column:1;margin-left:62px}
.qsg-scope .current-level{gap:10px}
.qsg-scope .target-level:before{content:"Target ";font-weight:400;color:#6a7788}
.qsg-scope .way-card{flex-wrap:wrap}
.qsg-scope .way-card>button{margin:0 0 6px}
.qsg-scope .way-copy p br{display:none}
.qsg-scope h1{font-size:30px}
}