.opp-scope{font-family:Arial,Helvetica,sans-serif;color:#17243a;font-size:14px}
.opp-scope{
  --green:#087e6e;
  --green-dark:#00665d;
  --navy:#102b4e;
  --text:#17243a;
  --muted:#50627a;
  --line:#dfe6ea;
  --shadow:0 2px 8px rgba(24,48,72,.08);
}
.opp-scope button, .opp-scope a{font-family:inherit}
.opp-scope .container{
  width:100%;
  max-width:1540px;
  margin:auto;
  padding:25px 30px 30px;
}
.opp-scope .back{
  display:flex;
  align-items:center;
  gap:8px;
  text-decoration:none;
  color:#102e52;
  font-size:12px;
  font-weight:700;
  margin-bottom:17px;
}
.opp-scope .back svg{
  width:16px;
  height:16px;
  stroke:#102e52;
  fill:none;
  stroke-width:1.7;
  stroke-linecap:round;
  stroke-linejoin:round;
}
.opp-scope .heading{
  display:flex;
  justify-content:space-between;
  align-items:flex-start;
  margin-bottom:17px;
}
.opp-scope h1{
  font-size:30px;
  line-height:1;
  margin:0;
  color:#102c50;
}
.opp-scope .sub{
  font-size:14px;
  color:#334761;
  margin:10px 0 0;
}
.opp-scope .actions{
  display:flex;
  gap:10px;
}
.opp-scope .action{
  height:40px;
  border-radius:6px;
  padding:0 27px;
  border:1px solid #e0e6ea;
  background:#fff;
  font-size:12px;
  font-weight:700;
  color:#151d2a;
  display:flex;
  align-items:center;
  justify-content:center;
  gap:8px;
  box-shadow:var(--shadow);
  cursor:pointer;
}
.opp-scope .action svg{
  width:17px;
  height:17px;
  stroke:#142943;
  fill:none;
  stroke-width:1.7;
  stroke-linecap:round;
  stroke-linejoin:round;
}
.opp-scope .action.apply{
  background:#078e68;
  color:#fff;
  border-color:#078e68;
  min-width:186px;
}
.opp-scope .action.apply svg{stroke:#fff}
.opp-scope .grid{
  display:grid;
  grid-template-columns:minmax(700px,785px) 468px;
  gap:11px;
}
.opp-scope .left,
.opp-scope .right{
  display:flex;
  flex-direction:column;
  gap:12px;
}
.opp-scope .card{
  border:1px solid var(--line);
  border-radius:10px;
  background:#fff;
  box-shadow:var(--shadow);
}
.opp-scope .hero{
  min-height:243px;
  padding:8px;
  display:flex;
  gap:24px;
}
.opp-scope .hero-image{
  width:252px;
  min-width:252px;
  height:221px;
  border-radius:8px;
  background:
    linear-gradient(135deg,rgba(3,65,55,.85),rgba(33,132,91,.45)),
    radial-gradient(circle at 70% 30%,#75c78a 0 12%,transparent 13%),
    linear-gradient(135deg,#7e9e78,#d7d3a0);
  position:relative;
  overflow:hidden;
}
.opp-scope .hero-image:before{
  content:"";
  position:absolute;
  width:150px;
  height:115px;
  border-radius:50% 50% 45% 45%;
  background:#267b48;
  left:58px;
  top:25px;
  box-shadow:
    -43px 28px 0 -4px #3d9657,
    42px 28px 0 -2px #39894e,
    -10px -20px 0 -4px #52a860,
    27px -17px 0 -5px #65b96c;
}
.opp-scope .hero-image:after{
  content:"";
  position:absolute;
  width:30px;
  height:100px;
  background:#6e5038;
  left:112px;
  top:93px;
  border-radius:8px;
}
.opp-scope .hero-info{
  padding:15px 0 8px;
  flex:1;
}
.opp-scope .recommend{
  display:inline-block;
  background:#008f67;
  color:#fff;
  border-radius:5px;
  padding:5px 8px;
  font-size:9px;
  font-weight:700;
  margin-bottom:9px;
}
.opp-scope .hero-title{
  font-size:22px;
  font-weight:700;
  color:#101b2b;
  margin:0 0 9px;
}
.opp-scope .hero-desc{
  font-size:13px;
  line-height:1.9;
  color:#233a57;
}
.opp-scope .meta{
  display:flex;
  gap:28px;
  align-items:flex-start;
  margin-top:18px;
  flex-wrap:wrap;
}
.opp-scope .meta-item{
  display:flex;
  align-items:center;
  gap:8px;
  font-size:11px;
  color:#172b47;
  white-space:nowrap;
}
.opp-scope .meta-item svg{
  width:17px;
  height:17px;
  stroke:#142d4e;
  fill:none;
  stroke-width:1.5;
  stroke-linecap:round;
  stroke-linejoin:round;
}
.opp-scope .offered{
  border-top:1px solid #e7ecef;
  margin-top:13px;
  padding-top:13px;
  display:flex;
  align-items:center;
  gap:13px;
  font-size:11px;
  color:#34465e;
}
.opp-scope .qf{
  width:25px;
  height:25px;
  border-radius:7px;
  background:#0a9b6d;
  color:#fff;
  display:grid;
  place-items:center;
  font-size:9px;
  font-weight:700;
}
.opp-scope .offered strong{
  color:#111d30;
  font-size:12px;
}
.opp-scope .section{
  padding:15px 16px;
}
.opp-scope .section-title{
  font-size:14px;
  font-weight:700;
  color:#141d2d;
}
.opp-scope .section-desc{
  font-size:11px;
  color:#324661;
  margin-top:7px;
}
.opp-scope .competencies{height:168px}
.opp-scope .comp-list{
  display:flex;
  justify-content:space-between;
  gap:10px;
  margin-top:17px;
}
.opp-scope .comp{
  display:flex;
  align-items:center;
  gap:10px;
}
.opp-scope .hex{
  width:47px;
  height:47px;
  display:grid;
  place-items:center;
  clip-path:polygon(25% 7%,75% 7%,100% 50%,75% 93%,25% 93%,0 50%);
}
.opp-scope .hex.green{background:#069b69}
.opp-scope .hex.blue{background:#287ed0}
.opp-scope .hex.teal{background:#0a9d9d}
.opp-scope .hex.purple{background:#7951bf}
.opp-scope .hex svg{
  width:23px;
  height:23px;
  stroke:#fff;
  fill:none;
  stroke-width:1.5;
  stroke-linecap:round;
  stroke-linejoin:round;
}
.opp-scope .comp-name{
  font-size:11px;
  font-weight:700;
  color:#142239;
  white-space:nowrap;
}
.opp-scope .tag{
  display:inline-block;
  margin-top:6px;
  padding:5px 8px;
  border-radius:4px;
  font-size:9px;
  background:#e2f4ed;
  color:#07835d;
  white-space:nowrap;
}
.opp-scope .tag.blue{
  background:#e5f1ff;
  color:#0b70cc;
}
.opp-scope .tag.purple{
  background:#eee8fa;
  color:#6847a5;
}
.opp-scope .mapping{
  text-align:center;
  margin-top:17px;
  font-size:11px;
  font-weight:700;
  color:#193250;
}
.opp-scope .mapping b{
  font-size:17px;
  margin-left:8px;
}
.opp-scope .evidence{height:144px}
.opp-scope .evlist{
  display:flex;
  margin-top:18px;
}
.opp-scope .ev{
  flex:1;
  display:flex;
  align-items:center;
  gap:12px;
  padding:0 14px;
  border-right:1px solid #e8edf0;
}
.opp-scope .ev:first-child{padding-left:0}
.opp-scope .ev:last-child{border-right:0}
.opp-scope .evicon{
  width:49px;
  height:49px;
  border-radius:50%;
  background:#e5f7ef;
  display:grid;
  place-items:center;
  flex:none;
}
.opp-scope .ev:nth-child(2) .evicon{background:#e9f3ff}
.opp-scope .ev:nth-child(3) .evicon{background:#f0eafb}
.opp-scope .evicon svg{
  width:24px;
  height:24px;
  stroke:#05976b;
  fill:none;
  stroke-width:1.5;
  stroke-linecap:round;
  stroke-linejoin:round;
}
.opp-scope .ev:nth-child(2) svg{stroke:#207fd0}
.opp-scope .ev:nth-child(3) svg{stroke:#7a5bc0}
.opp-scope .evname{
  font-size:11px;
  font-weight:700;
  color:#18263b;
}
.opp-scope .evtext{
  font-size:10px;
  line-height:1.45;
  color:#42546d;
  margin-top:5px;
  max-width:190px;
}
.opp-scope .verification{height:114px}
.opp-scope .verify{
  display:flex;
  align-items:center;
  justify-content:space-between;
  margin-top:19px;
}
.opp-scope .verify-item{
  display:flex;
  align-items:center;
  gap:10px;
  font-size:10px;
  color:#263a55;
}
.opp-scope .verify-item svg{
  width:21px;
  height:21px;
  stroke:#183250;
  fill:none;
  stroke-width:1.5;
  stroke-linecap:round;
  stroke-linejoin:round;
}
.opp-scope .details{
  height:243px;
  padding:12px 17px;
}
.opp-scope .detail{
  height:38px;
  border-bottom:1px solid #e8ecef;
  display:flex;
  align-items:center;
}
.opp-scope .detail:last-child{border-bottom:0}
.opp-scope .detail svg{
  width:17px;
  height:17px;
  stroke:#193352;
  fill:none;
  stroke-width:1.5;
  stroke-linecap:round;
  stroke-linejoin:round;
  margin-right:12px;
}
.opp-scope .label{
  font-size:10px;
  font-weight:700;
  color:#263a55;
}
.opp-scope .value{
  margin-left:auto;
  font-size:10px;
  color:#111d2f;
}
.opp-scope .rec{
  height:156px;
  background:linear-gradient(110deg,#effaf6,#f5faf8);
  padding:18px;
}
.opp-scope .rec-title{
  font-size:13px;
  font-weight:700;
  color:#142334;
}
.opp-scope .checkline{
  font-size:11px;
  color:#344860;
  margin-top:10px;
  display:flex;
  align-items:center;
  gap:10px;
}
.opp-scope .check{
  width:17px;
  height:17px;
  border-radius:50%;
  background:#dff3e9;
  color:#087e60;
  display:grid;
  place-items:center;
  font-size:11px;
  font-weight:700;
  flex:none;
}
.opp-scope .next{
  height:265px;
  padding:17px;
}
.opp-scope .next-title{
  font-size:14px;
  font-weight:700;
  color:#152031;
  margin-bottom:15px;
}
.opp-scope .next-grid{
  display:grid;
  grid-template-columns:1fr 140px;
  gap:10px;
}
.opp-scope .timeline{
  position:relative;
}
.opp-scope .timeline:before{
  content:"";
  position:absolute;
  left:11px;
  top:13px;
  bottom:13px;
  border-left:1px dashed #15956f;
}
.opp-scope .tl{
  position:relative;
  display:flex;
  gap:14px;
  margin-bottom:14px;
}
.opp-scope .num{
  width:23px;
  height:23px;
  border-radius:50%;
  background:#07966a;
  color:#fff;
  display:grid;
  place-items:center;
  font-size:11px;
  font-weight:700;
  z-index:1;
  flex:none;
}
.opp-scope .tl-title{
  font-size:11px;
  font-weight:700;
  color:#152238;
  margin-top:2px;
}
.opp-scope .tl-text{
  font-size:9px;
  color:#3e5069;
  margin-top:4px;
}
.opp-scope .badge-show{
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
}
.opp-scope .badge-circle{
  width:112px;
  height:112px;
  border-radius:50%;
  background:#edf8f4;
  display:grid;
  place-items:center;
}
.opp-scope .badge-circle svg{
  width:58px;
  height:58px;
  stroke:#06946b;
  fill:none;
  stroke-width:1.5;
  stroke-linecap:round;
  stroke-linejoin:round;
}
.opp-scope .badge-name{
  font-size:11px;
  font-weight:700;
  margin-top:10px;
}
.opp-scope .badge-small{
  font-size:9px;
  color:#43536a;
  margin-top:6px;
  text-align:center;
  line-height:1.5;
}
.opp-scope .learn{
  min-height:87px;
  background:#edf7ff;
  display:flex;
  align-items:center;
  padding:13px 15px;
  gap:17px;
}
.opp-scope .bulb{
  width:55px;
  height:55px;
  border-radius:50%;
  background:#dceeff;
  display:grid;
  place-items:center;
  font-size:25px;
  flex:none;
}
.opp-scope .learn-main{flex:1}
.opp-scope .learn-title{
  font-size:14px;
  font-weight:700;
}
.opp-scope .learn-desc{
  font-size:10px;
  line-height:1.5;
  color:#314761;
  margin-top:7px;
}
.opp-scope .tags{
  display:flex;
  flex-wrap:wrap;
  gap:8px;
  max-width:650px;
}
.opp-scope .pill{
  background:#dceeff;
  color:#0864ae;
  padding:7px 13px;
  border-radius:7px;
  font-size:9px;
  white-space:nowrap;
}
@media(max-width:1200px){
.opp-scope .grid{grid-template-columns:1fr}
.opp-scope .right{
    display:grid;
    grid-template-columns:1fr 1fr;
  }
}
@media(max-width:850px){
.opp-scope .container{padding:20px 14px}
.opp-scope .heading{display:block}
.opp-scope .actions{margin-top:18px}
.opp-scope .hero{
    height:auto;
    flex-direction:column;
  }
.opp-scope .hero-image{
    width:100%;
    height:220px;
  }
.opp-scope .right{display:flex}
.opp-scope .comp-list,
.opp-scope .evlist,
.opp-scope .verify{
    flex-wrap:wrap;
  }
.opp-scope .learn{
    height:auto;
    flex-wrap:wrap;
  }
}
@media(max-width:600px){
.opp-scope .hero-title{font-size:19px}
.opp-scope h1{font-size:26px}
.opp-scope .actions{width:100%;flex-direction:column}
.opp-scope .action{width:100%}
.opp-scope .comp-list,
.opp-scope .evlist{display:grid;grid-template-columns:1fr}
.opp-scope .ev{border-right:0;border-bottom:1px solid #e8edf0;padding:10px 0}
.opp-scope .verify{display:grid;grid-template-columns:1fr;gap:10px}
}
.opp-scope .container{
  max-width:none;
  padding:22px 26px 22px;
}
.opp-scope .back{
  margin-bottom:18px;
  font-size:10px;
}
.opp-scope .back svg{width:14px;height:14px}
.opp-scope .heading{
  margin-bottom:16px;
}
.opp-scope h1{
  font-size:24px;
  letter-spacing:-.4px;
}
.opp-scope .sub{
  font-size:11px;
  margin-top:8px;
}
.opp-scope .actions{gap:8px}
.opp-scope .action{
  height:33px;
  border-radius:6px;
  padding:0 22px;
  font-size:10px;
}
.opp-scope .action.apply{
  min-width:147px;
}
.opp-scope .action svg{width:14px;height:14px}
.opp-scope .grid{
  grid-template-columns:minmax(0,2fr) minmax(320px,1.18fr);
  gap:9px;
}
.opp-scope .left,
.opp-scope .right{gap:9px}
.opp-scope .card{
  border-radius:9px;
  box-shadow:0 1px 6px rgba(24,48,72,.07);
}
.opp-scope .hero{
  min-height:190px;
  height:190px;
  padding:6px;
  gap:18px;
}
.opp-scope .hero-image{
  width:200px!important;
  min-width:200px!important;
  height:176px!important;
  border-radius:7px;
  object-fit:cover;
  display:block;
  background:none!important;
}
.opp-scope .hero-image:before,
.opp-scope .hero-image:after{
  display:none!important;
}
.opp-scope .hero-info{
  padding:9px 0 5px;
}
.opp-scope .recommend{
  padding:4px 7px;
  font-size:8px;
  border-radius:4px;
  margin-bottom:7px;
}
.opp-scope .hero-title{
  font-size:17px;
  margin-bottom:7px;
  letter-spacing:-.25px;
}
.opp-scope .hero-desc{
  font-size:10px;
  line-height:1.8;
}
.opp-scope .meta{
  gap:24px;
  margin-top:15px;
}
.opp-scope .meta-item{
  font-size:9px;
  gap:6px;
}
.opp-scope .meta-item svg{
  width:14px;
  height:14px;
}
.opp-scope .offered{
  margin-top:10px;
  padding-top:10px;
  gap:10px;
  font-size:9px;
}
.opp-scope .qf{
  width:22px;
  height:22px;
  border-radius:6px;
  font-size:8px;
}
.opp-scope .offered strong{font-size:10px}
.opp-scope .section{padding:11px 12px}
.opp-scope .section-title{font-size:11px}
.opp-scope .section-desc{font-size:9px;margin-top:5px}
.opp-scope .competencies{height:123px}
.opp-scope .comp-list{margin-top:13px;gap:8px}
.opp-scope .comp{gap:7px}
.opp-scope .hex{width:36px;height:36px}
.opp-scope .hex svg{width:18px;height:18px}
.opp-scope .comp-name{font-size:9px}
.opp-scope .tag{font-size:7px;padding:4px 6px;margin-top:4px}
.opp-scope .mapping{margin-top:10px;font-size:8px}
.opp-scope .mapping b{font-size:13px}
.opp-scope .evidence{height:110px}
.opp-scope .evlist{margin-top:13px}
.opp-scope .ev{gap:9px;padding:0 10px}
.opp-scope .evicon{width:39px;height:39px}
.opp-scope .evicon svg{width:19px;height:19px}
.opp-scope .evname{font-size:9px}
.opp-scope .evtext{font-size:8px;line-height:1.4;margin-top:4px}
.opp-scope .verification{height:88px}
.opp-scope .verify{margin-top:13px}
.opp-scope .verify-item{font-size:8px;gap:7px}
.opp-scope .verify-item svg{width:17px;height:17px}
.opp-scope .learn{
  min-height:69px;
  padding:10px 12px;
  gap:12px;
}
.opp-scope .bulb{width:44px;height:44px;font-size:20px}
.opp-scope .learn-title{font-size:10px}
.opp-scope .learn-desc{font-size:8px;margin-top:5px}
.opp-scope .tags{gap:6px;max-width:560px}
.opp-scope .pill{font-size:7px;padding:5px 10px}
.opp-scope .details{
  height:190px;
  padding:8px 12px;
}
.opp-scope .detail{
  height:28px;
}
.opp-scope .detail svg{
  width:14px;
  height:14px;
  margin-right:9px;
}
.opp-scope .label,
.opp-scope .value{font-size:8px}
.opp-scope .rec{
  height:125px;
  padding:13px;
}
.opp-scope .rec-title{font-size:10px}
.opp-scope .checkline{
  font-size:8px;
  margin-top:7px;
  gap:7px;
}
.opp-scope .check{
  width:13px;
  height:13px;
  font-size:8px;
}
.opp-scope .next{
  height:212px;
  padding:12px;
}
.opp-scope .next-title{font-size:10px;margin-bottom:11px}
.opp-scope .next-grid{
  grid-template-columns:1fr 112px;
  gap:7px;
}
.opp-scope .timeline:before{
  left:9px;
  top:10px;
  bottom:10px;
}
.opp-scope .tl{
  gap:10px;
  margin-bottom:11px;
}
.opp-scope .num{
  width:19px;
  height:19px;
  font-size:8px;
}
.opp-scope .tl-title{font-size:8px}
.opp-scope .tl-text{font-size:7px;margin-top:3px}
.opp-scope .badge-circle{
  width:88px;
  height:88px;
}
.opp-scope .badge-circle svg{
  width:47px;
  height:47px;
}
.opp-scope .badge-name{font-size:9px;margin-top:8px}
.opp-scope .badge-small{font-size:7px;margin-top:4px}
@media(max-width:900px){
.opp-scope .grid{grid-template-columns:1fr}
.opp-scope .right{display:flex}
}
@media(max-width:700px){
.opp-scope .container{padding:16px 12px}
.opp-scope .hero{
    height:auto;
    min-height:0;
    flex-direction:column;
  }
.opp-scope .hero-image{
    width:100%!important;
    min-width:0!important;
    height:220px!important;
  }
.opp-scope .comp-list{display:grid;grid-template-columns:1fr 1fr}
.opp-scope .evlist{display:grid;grid-template-columns:1fr}
.opp-scope .ev{padding:8px 0;border-right:0;border-bottom:1px solid #e8edf0}
.opp-scope .verify{display:grid;grid-template-columns:1fr 1fr;gap:8px}
}
.opp-scope .learn{
  width:100%;
  height:69px !important;
  min-height:69px !important;
  margin-top:0;
  border-radius:9px;
  background:#edf7ff !important;
  border:1px solid #e3edf5;
  display:flex !important;
  align-items:center !important;
  padding:8px 14px !important;
  gap:13px !important;
  overflow:hidden;
}
.opp-scope .learn .bulb{
  width:44px !important;
  height:44px !important;
  min-width:44px !important;
  border-radius:50%;
  background:#dceeff !important;
  display:grid !important;
  place-items:center;
  font-size:20px !important;
