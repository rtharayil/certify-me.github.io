---
layout: null
sitemap:
  exclude: 'yes'
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- assign sitemap_documents = site.pages -%}
{%- for collection in site.collections -%}
  {%- if collection.output -%}
    {%- assign sitemap_documents = sitemap_documents | concat: collection.docs -%}
  {%- endif -%}
{%- endfor -%}
{%- assign sitemap_documents = sitemap_documents | sort: "url" -%}
{%- assign previous_url = "" -%}
{%- for document in sitemap_documents -%}
  {%- assign excluded = false -%}
  {%- assign robots = document.robots | default: "" | downcase -%}
  {%- if document.layout == nil or document.layout == "redirected" or document.redirect_to or document.sitemap == false or document.sitemap.exclude == "yes" or document.sitemap.exclude == true or robots contains "noindex" -%}
    {%- assign excluded = true -%}
  {%- endif -%}
  {%- if document.url == "/404.html" or document.url == "/404" or document.url contains "/EPTemplates/" or document.url contains "/BSIsample/" or document.url contains "/devopsma/" or document.url contains "/nyc/" or document.url contains "/Qatar/" -%}
    {%- assign excluded = true -%}
  {%- endif -%}
  {%- if document.name == "preprod.html" or document.name == "preprod.md" or document.name == "samples.html" or document.name == "samples.md" or document.name == "test.html" or document.name == "test.md" or document.name == "sample-credential.md" -%}
    {%- assign excluded = true -%}
  {%- endif -%}
  {%- assign canonical = document.url | prepend: site.canonical_origin -%}
  {%- if document.canonical_url and document.canonical_url != canonical and document.canonical_url != document.url -%}
    {%- assign excluded = true -%}
  {%- endif -%}
  {%- unless excluded or document.url == previous_url %}
  <url>
    <loc>{{ canonical | xml_escape }}</loc>
    {%- if document.sitemap.lastmod %}
    <lastmod>{{ document.sitemap.lastmod | date: "%Y-%m-%d" }}</lastmod>
    {%- elsif document.last_modified_at %}
    <lastmod>{{ document.last_modified_at | date: "%Y-%m-%d" }}</lastmod>
    {%- endif %}
    {%- if document.sitemap.priority %}
    <priority>{{ document.sitemap.priority }}</priority>
    {%- endif %}
  </url>
  {%- assign previous_url = document.url -%}
  {%- endunless -%}
{%- endfor %}
</urlset>