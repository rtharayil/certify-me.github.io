{
  "name": "workspace",
  "version": "1.0.0",
  "description": "## Validation",
  "main": "index.js",
  "scripts": {
    "test:case-studies": "XDG_CONFIG_HOME=/tmp/case-studies-config XDG_CACHE_HOME=/tmp/case-studies-cache node scripts/validate-case-studies-index.cjs",
    "build:performance-css": "node scripts/build-performance-css.cjs",
    "test": "npm run test:private-uploads && npm run test:comparison-mobile && npm run test:images && npm run test:cta-contrast",
    "test:cta-contrast": "npm run build:performance-css && bundle exec jekyll build && node scripts/validate-cta-contrast.cjs",
    "test:images": "npm run test:intrinsic-images && npm run test:image-proportions",
    "test:intrinsic-images": "bundle exec ruby scripts/validate-intrinsic-images.rb",
    "test:image-proportions": "node scripts/validate-image-proportions.cjs",
    "test:private-uploads": "bundle exec ruby scripts/validate-private-uploads.rb",
    "test:comparison-mobile": "node scripts/validate-comparison-mobile.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "playwright": "^1.62.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  }
}
