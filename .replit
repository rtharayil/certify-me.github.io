modules = ["web", "nodejs-20", "ruby-3.2", "python-3.11"]
[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"

[nix]
channel = "stable-25_05"
packages = ["chromium"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "comparison-pages"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "private-uploads"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bundle exec jekyll serve --host 0.0.0.0 --port 5000 --skip-initial-build"
waitForPort = 5000

[[workflows.workflow]]
name = "comparison-pages"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bundle exec ruby scripts/validate-comparison-pages.rb && npm run test:comparison-mobile"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "private-uploads"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run test:private-uploads"

[workflows.workflow.metadata]
isValidation = true

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 23636
externalPort = 3001

[deployment]
deploymentTarget = "static"
build = ["bash", "-c", "npm ci --include=dev && npm run build:performance-css && bundle install && bundle exec jekyll build"]
publicDir = "_site"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000

# Phase 5: response headers apply after republishing, not in Jekyll preview.
[[deployment.responseHeaders]]
path = "/assets4/performance/*"
name = "Cache-Control"
value = "public, max-age=31536000, immutable"

[[deployment.responseHeaders]]
path = "/assets4/css/animate.607d3304452a.min.css"
name = "Cache-Control"
value = "public, max-age=31536000, immutable"

